# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:5173
# Exact comma-separated browser origins permitted to send cookie-authenticated
# unsafe requests. In production, do not use wildcards; PUBLIC_BASE_URL is also trusted.
TRUSTED_ORIGINS=
# Leave unset for development/test. Production defaults to Secure and rejects
# an explicit false value; production deployments may only set this to true.
# COOKIE_SECURE=true

# Cloud providers (never expose these values to the browser)
QWEN_API_KEY=
# Alibaba docs also call this DASHSCOPE_API_KEY; either name is accepted.
# DASHSCOPE_API_KEY=
# Beijing business-space endpoint; replace {WorkspaceId} with your Bailian workspace ID.
QWEN_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_LLM_MODEL=qwen3.5-flash
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QWEN_TTS_FALLBACK_MODEL=qwen3-tts-vc-2026-01-22
QWEN_TTS_VOICE=longanhuan_v3.6
# Optional override; otherwise derived from QWEN_BASE_URL.
# BAILIAN_TTS_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
MIMO_API_KEY=
MIMO_BASE_URL=

# Persistence
DATABASE_URL=postgresql://weiguang@127.0.0.1:55433/weiguang
REDIS_URL=redis://127.0.0.1:6379/0

# Production monitoring. Prices are current public Beijing list prices and
# should be reconciled with the actual Bailian bill before global hard rollout.
MONITOR_DAILY_BUDGET_CNY=20
MONITOR_FAILURE_RATE_PERCENT=5
QWEN_LLM_INPUT_CNY_PER_MILLION=0.2
QWEN_LLM_OUTPUT_CNY_PER_MILLION=2
QWEN_TTS_CNY_PER_10K_CHARACTERS=1
OSS_REGION=cn-beijing
OSS_BUCKET=weiguang-dev-20260823
OSS_PUBLIC_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_INTERNAL_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# Product limits
MAX_UPLOAD_MB=50
MAX_AUDIO_SECONDS=300
MAX_CONCURRENT_TURNS=25
FREE_REQUEST_QUOTA=20
# shadow records and reports overages without blocking. hard rejects before a
# paid Provider call when the database-backed reservation cannot be made.
BILLING_ENFORCEMENT_MODE=shadow
# Optional comma-separated stable user IDs for internal hard-mode grey testing.
# Keep emails and passwords out of this setting.
BILLING_HARD_USER_IDS=

# Optional external sales links. Only HTTPS links under ldxp.cn are exposed.
LDXP_PLUS_PRODUCT_URL=
LDXP_PRO_PRODUCT_URL=
